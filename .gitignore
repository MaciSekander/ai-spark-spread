.env
.venv/
__pycache__/
.ipynb_checkpoints/
.DS_Store

# Raw API downloads are re-creatable; keep them out of the repo...
data/raw/*
!data/raw/.gitkeep
# ...except the daily price history, which can't be re-downloaded later. The daily job commits these.
!data/raw/vast_snapshots.csv
!data/raw/openrouter_price_snapshots.csv
!data/raw/eia_retail_prices.csv
!data/raw/eia_retail_prices.refreshed

# Website build output and caches
site/node_modules/
site/dist/
site/src/.observablehq/cache/
# Generated by `python -m spark.build` (locally and in CI)
site/src/data/spark.json
